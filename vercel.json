      "statusCode": 301
    },
    {
      "source": "/comunidad/configuracion",
      "destination": "/comunidad/ajustes",
      "statusCode": 301
    },
    {
      "source": "/comunidad/ai",
      "destination": "/ai",
      "statusCode": 301
    },
    {
      "source": "/comunidad/ai/:rest*",
      "destination": "/ai/:rest*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/videos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/jobs-expiry",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/job-alerts",
      "schedule": "30 13 * * *"
    }
  ]
}
